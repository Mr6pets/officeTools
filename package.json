{
  "name": "officeTools",
  "version": "1.0.0",
  "description": "多功能办公工具集",
  "main": "public/electron.js",
  "homepage": "./",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "electron": "concurrently \"npm run dev\" \"wait-on http://localhost:5173 && electron .\"",
    "electron-dev": "concurrently \"npm run dev\" \"wait-on http://localhost:5173 && electron .\"",
    "electron-pack": "npm run build && electron-builder",
    "preelectron-pack": "npm run build"
  },
  "build": {
    "appId": "com.officetools.app",
    "productName": "Office Tools",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "public/electron.js",
      "public/icon.png",
      "node_modules/**/*"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": "dmg"
    },
    "win": {
      "target": "nsis",
      "icon": "public/icon.png"
    },
    "linux": {
      "target": "AppImage",
      "category": "Office"
    }
  },
  "repository": "git@github.com:Mr6pets/officeTools.git",
  "author": "alvisliu <alvispets@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "@types/marked": "^5.0.2",
    "antd": "^5.12.0",
    "crypto-js": "^4.2.0",
    "file-saver": "^2.0.5",
    "jszip": "^3.10.1",
    "marked": "^16.1.1",
    "pdf-lib": "^1.17.1",
    "prettier": "^3.6.2",
    "qrcode": "^1.5.3",
    "qrcode-reader": "^1.0.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tesseract.js": "^5.0.0"
  },
  "devDependencies": {
    "@types/crypto-js": "^4.2.2",
    "@types/file-saver": "^2.0.7",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "electron-is-dev": "^2.0.0",
    "typescript": "^5.0.0",
    "vite": "^5.0.0",
    "wait-on": "^7.2.0"
  }
}
